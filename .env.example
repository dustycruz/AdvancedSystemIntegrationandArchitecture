# =====================================================================
#  Store Platform Capstone - environment configuration
#
#  LOCAL DEVELOPMENT VALUES ONLY. Nothing in this file is a real secret.
#  Every value below is a throwaway default for containers that run on
#  your own machine. Do not reuse them anywhere else.
#
#  How to use:
#    1. Run setup.cmd  (copies this file to .env if .env does not exist)
#    2. docker compose up --build
#
#  .env is gitignored. Commit changes to .env.example only, and never
#  put a real credential in it.
#
#  Format rules: KEY=value, no spaces around "=", no quotes, and avoid
#  the characters "#" and "$" inside values.
# =====================================================================

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
COMPOSE_PROJECT_NAME=storeplatform
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------
# Host ports (what you open in the browser)
#   Gateway is the only API entry point. The per-service ports exist so
#   each service's Swagger UI can be opened directly during development.
#   Databases are intentionally not published to the host.
# ---------------------------------------------------------------------
GATEWAY_PORT=5000
STOREFRONT_PORT=5100
IDENTITY_API_PORT=5001
CATALOG_API_PORT=5002
INVENTORY_API_PORT=5003
ORDER_API_PORT=5004
PAYMENT_API_PORT=5005
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------------------------------------------------------------
# JWT - issued by Identity.Api, validated by the gateway and every service.
#   JWT_KEY must be at least 32 characters (HMAC-SHA256).
# ---------------------------------------------------------------------
JWT_KEY=local-dev-only-jwt-signing-key-not-a-secret-0123456789
JWT_ISSUER=store-platform-identity
JWT_AUDIENCE=store-platform
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------
# RabbitMQ - broker defaults (guest/guest is the image default, local only)
# ---------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=store.events
RABBITMQ_DEAD_LETTER_EXCHANGE=store.dlx
# Failed deliveries before a message is rejected to its "<queue>.dlq"
RABBITMQ_MAX_DELIVERY_ATTEMPTS=3

# ---------------------------------------------------------------------
# PostgreSQL - one database container per service (database-per-service)
# ---------------------------------------------------------------------
IDENTITY_DB_HOST=identity-db
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_local_dev_pw

CATALOG_DB_HOST=catalog-db
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_local_dev_pw

INVENTORY_DB_HOST=inventory-db
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_local_dev_pw

ORDER_DB_HOST=order-db
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_local_dev_pw

PAYMENT_DB_HOST=payment-db
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_local_dev_pw

# ---------------------------------------------------------------------
# Seeded demo accounts (created by Identity.Api at first startup)
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@storeplatform.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@storeplatform.local
SEED_CUSTOMER_PASSWORD=Customer@12345
