@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="ac-card empty-state">
            <i class="bi @Model.Icon" aria-hidden="true"></i>
            <p class="display-6 fw-bold mt-3 mb-0 display-font">@Model.StatusCode</p>
            <h1 class="h3 mt-2">@Model.Title</h1>
            <p class="text-muted">@Model.Message</p>
            <div class="d-flex justify-content-center flex-wrap gap-2 mt-3">
                @if (Model.StatusCode == 401)
                {
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
                }
                <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Back to the shop</a>
            </div>
            @if (!string.IsNullOrEmpty(Model.CorrelationId))
            {
                <p class="small text-muted mt-4 mb-0">Reference: <code>@Model.CorrelationId</code></p>
            }
        </div>
    </div>
</div>
