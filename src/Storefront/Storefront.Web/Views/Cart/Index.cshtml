@model CartViewModel
@{
    ViewData["Title"] = "Your cart";
}
<h1 class="h2 mb-4">Your cart</h1>
@if (Model.MissingProducts.Count > 0)
{
    <div class="alert alert-info" role="status">Some items were removed because they are no longer in the catalog.</div>
}
@if (Model.Lines.Count == 0)
{
    <div class="ac-card empty-state">
        <i class="bi bi-bag" aria-hidden="true"></i>
        <h2 class="h5 mt-3">Your cart is empty</h2>
        <p class="text-muted">Find something you like in the shop.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-shop me-1" aria-hidden="true"></i>Start shopping</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="ac-card p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var line in Model.Lines)
                    {
                        <li class="list-group-item p-3 bg-transparent">
                            <div class="d-flex gap-3 align-items-center flex-wrap">
                                <i class="bi @Display.ProductIcon(line.Product.Sku) fs-2 text-primary" aria-hidden="true"></i>
                                <div class="flex-grow-1">
                                    <a class="fw-semibold text-decoration-none" asp-controller="Home" asp-action="Product" asp-route-id="@line.Product.Id">@line.Product.Name</a>
                                    <div class="small text-muted">@Display.Money(line.Product.Price) each</div>
                                    @if (!line.Product.IsActive)
                                    {
                                        <div class="small text-danger"><i class="bi bi-x-circle me-1" aria-hidden="true"></i>No longer for sale - please remove it.</div>
                                    }
                                    else if (line.Available is not null && line.Available < line.Quantity)
                                    {
                                        <div class="small text-danger"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Only @line.Available available.</div>
                                    }
                                </div>
                                <form asp-action="Update" method="post" class="d-flex align-items-center gap-2">
                                    <input type="hidden" name="productId" value="@line.Product.Id" />
                                    <label class="visually-hidden" for="qty-@line.Product.Id">Quantity of @line.Product.Name</label>
                                    <input id="qty-@line.Product.Id" name="quantity" type="number" min="0" max="10" value="@line.Quantity" class="form-control form-control-sm" style="width:5rem" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Update</button>
                                </form>
                                <form asp-action="Update" method="post">
                                    <input type="hidden" name="productId" value="@line.Product.Id" />
                                    <input type="hidden" name="quantity" value="0" />
                                    <button type="submit" class="btn btn-link text-danger btn-sm" aria-label="Remove @line.Product.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                                <div class="price text-end" style="min-width:7rem">@Display.Money(line.LineTotal)</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-lg-4">
            <aside class="ac-card p-4" aria-labelledby="summary-title">
                <h2 id="summary-title" class="h5">Order summary</h2>
                <div class="d-flex justify-content-between my-3"><span>@Model.ItemCount item(s)</span><span class="price">@Display.Money(Model.Total)</span></div>
                <p class="small text-muted">Prices are confirmed by the catalog when you place the order.</p>
                @if (Model.CanCheckout)
                {
                    <a class="btn btn-gold btn-lg w-100" asp-action="Checkout"><i class="bi bi-lock me-1" aria-hidden="true"></i>Checkout</a>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg w-100" disabled>Fix the items above to check out</button>
                }
            </aside>
        </div>
    </div>
}
