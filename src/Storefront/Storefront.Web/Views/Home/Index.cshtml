@model CatalogViewModel
@{
    ViewData["Title"] = "Shop";
}
<section class="ac-hero p-4 p-md-5 mb-4" aria-labelledby="hero-title">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="text-uppercase small fw-semibold mb-2" style="letter-spacing:.2em;color:var(--ac-gold-light)">Official campus store</p>
            <h1 id="hero-title" class="display-5 fw-bold mb-3">Wear your Angelicum pride</h1>
            <p class="lead mb-4">Hoodies, tees, notebooks and everyday essentials, reserved and paid for in seconds - and you can watch every step of your order.</p>
            <form class="d-flex gap-2" role="search" method="get" asp-action="Index">
                <label class="visually-hidden" for="q">Search products</label>
                <input id="q" name="q" value="@Model.Search" class="form-control form-control-lg" type="search" placeholder="Search hoodies, notebooks…" />
                <button class="btn btn-gold btn-lg" type="submit"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Search</span></button>
            </form>
        </div>
    </div>
</section>

@if (Model.StockUnavailable)
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="status">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        Live stock levels are temporarily unavailable. You can still browse and add items to your cart.
    </div>
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <h2 class="h3 mb-0">@(string.IsNullOrWhiteSpace(Model.Search) ? "All products" : $"Results for “{Model.Search}”")</h2>
    <span class="text-muted small">@Model.Products.Count item(s)</span>
</div>

@if (Model.Products.Count == 0)
{
    <div class="ac-card empty-state">
        <i class="bi bi-search" aria-hidden="true"></i>
        <h3 class="h5 mt-3">No products match your search</h3>
        <p class="text-muted">Try another word, or browse everything we have.</p>
        <a class="btn btn-primary" asp-action="Index">Show all products</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 stagger">
        @for (var i = 0; i < Model.Products.Count; i++)
        {
            var card = Model.Products[i];
            var p = card.Product;
            <div class="col" style="--i:@i">
                <article class="ac-card product-card d-flex flex-column" aria-labelledby="p-@p.Id">
                    <a asp-action="Product" asp-route-id="@p.Id" tabindex="-1" aria-hidden="true">
                        <partial name="_ProductMedia" model="p" />
                    </a>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="mb-2"><partial name="_StockBadge" model="card" /></div>
                        <h3 class="h6 mb-1" id="p-@p.Id"><a class="text-decoration-none" asp-action="Product" asp-route-id="@p.Id">@p.Name</a></h3>
                        <p class="small text-muted mb-3 flex-grow-1">@p.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price">@Display.Money(p.Price)</span>
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@p.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="btn btn-primary btn-sm" disabled="@(!card.InStock)" aria-label="Add @p.Name to cart">
                                    <span class="spinner-border spinner-border-sm btn-spinner me-1" aria-hidden="true"></span>
                                    <span class="btn-label"><i class="bi bi-bag-plus me-1" aria-hidden="true"></i>Add</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
